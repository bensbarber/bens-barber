<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>By.LinoushCréation | L'Art de la Rose & Bijoux</title>
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Cinzel:wght@400;700&family=Montserrat:wght@200;300;400;600&family=Cormorant+Garamond:ital,wght@0,400;0,600;1,400&display=swap');

        :root {
            --white: #ffffff;
            --black: #0a0a0a;
            --light-gray: rgba(255, 255, 255, 0.1);
            --out-of-stock: #ff4d4d;
            --paypal-blue: #0070ba;
            --rose-petal: #d42d42;
            --gold: #d4af37;
        }

        html { scroll-behavior: smooth; overflow-x: hidden; }
        body { font-family: 'Montserrat', sans-serif; margin: 0; background-color: var(--black); color: var(--white); -webkit-font-smoothing: antialiased; }

        .bg-roses { position: fixed; top: 0; left: 0; width: 100%; height: 100%; pointer-events: none; z-index: -1; background: radial-gradient(circle at center, #1a1a1a 0%, #0a0a0a 100%); overflow: hidden; }
        .petal { position: absolute; background-color: var(--rose-petal); border-radius: 150% 0 150% 0; opacity: 0.3; filter: blur(0.5px); animation: fall linear infinite; }
        @keyframes fall {
            0% { transform: translateY(-10vh) translateX(0) rotate(0deg); opacity: 0; }
            100% { transform: translateY(110vh) translateX(100px) rotate(360deg); opacity: 0; }
        }

        header { padding: 25px 5%; text-align: center; background: rgba(10, 10, 10, 0.9); backdrop-filter: blur(15px); position: sticky; top: 0; z-index: 1000; border-bottom: 1px solid var(--light-gray); }
        .brand-logo { width: 50px; height: 50px; border-radius: 50%; border: 1px solid var(--gold); vertical-align: middle; margin-right: 10px; }
        .logo-text { font-family: 'Cinzel', serif; font-size: 1.8rem; letter-spacing: 5px; display: inline-block; color: var(--gold); }
        nav.nav-links { display: flex; justify-content: center; gap: 30px; margin-top: 15px; }
        nav.nav-links a { text-decoration: none; color: var(--white); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 2px; opacity: 0.6; transition: 0.3s; }
        nav.nav-links a:hover { opacity: 1; color: var(--gold); }

        .container { max-width: 1200px; margin: 0 auto; padding: 60px 5%; }
        .section-label { text-align: center; font-family: 'Cinzel', serif; font-size: 1.4rem; letter-spacing: 6px; margin-bottom: 50px; text-transform: uppercase; }

        .price-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 20px; }
        .price-card { background: rgba(26, 26, 26, 0.4); border: 1px solid var(--light-gray); padding: 30px; text-align: center; transition: 0.4s; }
        .price-card:hover { border-color: var(--gold); transform: translateY(-5px); }
        .qty { font-family: 'Cormorant Garamond', serif; font-size: 2rem; color: var(--gold); }

        .custom-section { background: rgba(0, 0, 0, 0.8); padding: 80px 5%; }
        .deco-grid { max-width: 1100px; margin: 0 auto; display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 40px; }
        .deco-cat h3 { font-family: 'Cinzel', serif; font-size: 1.1rem; border-bottom: 1px solid var(--gold); padding-bottom: 10px; margin-bottom: 20px; letter-spacing: 2px; text-align: center; color: var(--gold); }
        .deco-item { display: flex; justify-content: space-between; margin-bottom: 12px; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 1px; }
        .dots { flex: 1; border-bottom: 1px dotted rgba(255,255,255,0.2); margin: 0 10px 5px; }

        .sold-out { opacity: 0.4; filter: grayscale(1); pointer-events: none; }
        .sold-out-badge { color: var(--out-of-stock); font-size: 0.6rem; font-weight: bold; border: 1px solid var(--out-of-stock); padding: 2px 5px; margin-left: 10px; }

        .order-container { max-width: 900px; margin: 80px auto; padding: 50px 5%; background: rgba(20, 20, 20, 0.8); border: 1px solid var(--light-gray); border-top: 3px solid var(--gold); }
        .form-group { margin-bottom: 35px; }
        label { display: block; font-family: 'Cinzel', serif; font-size: 0.85rem; margin-bottom: 15px; letter-spacing: 2px; color: var(--gold); }
        select, input, textarea { width: 100%; padding: 15px; background: #000; border: 1px solid var(--light-gray); color: #fff; box-sizing: border-box; font-size: 0.8rem; }

        .selection-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 12px; }
        .check-card { background: rgba(255,255,255,0.05); padding: 12px; font-size: 0.65rem; display: flex; align-items: center; gap: 12px; cursor: pointer; border: 1px solid transparent; text-transform: uppercase; transition: 0.3s; }
        .check-card:hover { border-color: var(--gold); }
        .check-card input { width: 16px; height: 16px; accent-color: var(--gold); }

        .dynamic-field { margin-top: 10px; display: none; width: 100%; animation: fadeIn 0.3s forwards; }
        @keyframes fadeIn { from { opacity: 0; transform: translateY(-5px); } to { opacity: 1; transform: translateY(0); } }

        .live-details { text-align: left; font-size: 0.75rem; margin-bottom: 20px; padding: 15px; border-left: 2px solid var(--gold); background: rgba(255,255,255,0.02); }
        .live-details div { display: flex; justify-content: space-between; margin-bottom: 5px; opacity: 0.8; }

        .price-summary { background: #000; padding: 30px; text-align: center; border: 1px solid var(--gold); margin-top: 10px; }
        .total-amount { font-family: 'Cormorant Garamond', serif; font-size: 3rem; color: var(--gold); font-weight: 600; }

        .btn-group { display: grid; grid-template-columns: 1fr 1fr; gap: 15px; margin-top: 20px; }
        .btn-submit { padding: 20px; border: none; font-family: 'Cinzel', serif; font-weight: 700; cursor: pointer; letter-spacing: 2px; text-transform: uppercase; transition: 0.3s; font-size: 0.75rem; }
        .btn-total { background: var(--paypal-blue); color: #fff; }
        .btn-acompte { background: transparent; border: 1px solid var(--paypal-blue); color: var(--paypal-blue); }

        #thankYouModal { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.98); z-index: 2000; justify-content: center; align-items: center; text-align: center; }
        .modal-content { background: #111; padding: 30px; border: 1px solid var(--gold); max-width: 450px; width: 90%; }
        .copy-box { background: #000; border: 1px dashed var(--gold); padding: 15px; margin: 20px 0; font-size: 0.8rem; color: #fff; text-align: left; white-space: pre-wrap; }

        footer { text-align: center; padding: 40px; font-size: 0.7rem; opacity: 0.6; letter-spacing: 2px; line-height: 1.8; }
        .footer-link { color: var(--gold); text-decoration: none; border-bottom: 1px solid transparent; transition: 0.3s; font-weight: 600; }

        #adminPanel { display: none; position: fixed; bottom: 70px; right: 20px; z-index: 1000; background: rgba(0,0,0,0.9); padding: 20px; border: 1px solid var(--gold); border-radius: 5px; max-width: 300px; max-height: 80vh; overflow-y: auto; }
        #adminPanel h3, #adminPanel h4 { margin-top: 0; color: var(--gold); font-family: 'Cinzel', serif; }
        #adminPanel input, #adminPanel select { width: 100%; padding: 8px; margin-bottom: 10px; background: #000; border: 1px solid var(--light-gray); color: #fff; }
        #adminPanel button { padding: 8px 15px; background: var(--gold); color: #000; border: none; cursor: pointer; width: 100%; margin-bottom: 10px; }
        #adminButton { position: fixed; bottom: 20px; right: 20px; z-index: 1000; background: var(--gold); color: #000; border: none; border-radius: 50%; width: 50px; height: 50px; cursor: pointer; font-weight: bold; font-size: 0.7rem; }
    </style>
</head>
<body>
    <div class="bg-roses" id="rosesBg"></div>

    <header>
        <div class="brand-container">
            <img src="https://i.ibb.co/B2KW28r4/IMG-4055.jpg" alt="Logo" class="brand-logo">
            <h1 class="logo-text">BY.<span>LINOUSH</span></h1>
        </div>
        <nav class="nav-links">
            <a href="#roses">Compositions</a>
            <a href="#catalogue">Catalogue</a>
            <a href="#commander">Commander</a>
        </nav>
    </header>

    <div id="thankYouModal">
        <div class="modal-content">
            <h2 style="font-family: 'Cinzel', serif; color: var(--gold); margin-bottom: 10px;">Récapitulatif Envoyé</h2>
            <p style="font-size: 0.8rem;">Votre commande a été envoyée par mail. Copiez ce texte pour le coller sur PayPal :</p>
            <div class="copy-box" id="orderSummaryText"></div>
            <button onclick="redirectToPayPal()" class="btn-submit btn-total" style="width: 100%;">Aller sur PayPal</button>
        </div>
    </div>

    <div class="container" id="roses">
        <h2 class="section-label" data-aos="fade-up">✨ Nos Roses Artisanales ✨</h2>
        <div class="price-grid">
            <div class="price-card" data-aos="fade-up"><div class="qty">13 roses</div><div class="amount">25€</div></div>
            <div class="price-card" data-aos="fade-up" data-aos-delay="100"><div class="qty">18 roses</div><div class="amount">35€</div></div>
            <div class="price-card" data-aos="fade-up" data-aos-delay="200"><div class="qty">30 roses</div><div class="amount">59€</div></div>
            <div class="price-card" data-aos="fade-up" data-aos-delay="300"><div class="qty">50 roses</div><div class="amount">99€</div></div>
            <div class="price-card" data-aos="zoom-in" style="border-color: var(--gold);"><div class="qty">101 roses</div><div class="amount">225€</div><small>3 DÉCOS OFFERTES</small></div>
        </div>
    </div>

    <section class="custom-section" id="catalogue">
        <div class="deco-grid">
            <div class="deco-cat" data-aos="fade-up">
                <h3>🌹 Roses Éternelles</h3>
                <div class="deco-item"><span>Rose sous cloche</span><div class="dots"></div><span>20€</span></div>
                <div class="deco-item"><span>Perso (Prénom)</span><div class="dots"></div><span>25€</span></div>
            </div>
            <div class="deco-cat" data-aos="fade-up">
                <h3>💎 Collection Bijoux</h3>
                <div class="deco-item"><span>Rose boîte à bijoux + bague</span><div class="dots"></div><span>20€</span></div>
                <div class="deco-item"><span>Box bijoux (Bracelet)</span><div class="dots"></div><span>10€</span></div>
                <div class="deco-item"><span>Option Perso Box</span><div class="dots"></div><span>+5€</span></div>
            </div>
            <div class="deco-cat sold-out" data-aos="fade-up">
                <h3>🌙 Univers Prière <span class="sold-out-badge">RUPTURE</span></h3>
                <div class="deco-item"><span>Tapis Perso</span><div class="dots"></div><span>16€</span></div>
                <div class="deco-item"><span>Coffret S / M</span><div class="dots"></div><span>40€ / 46€</span></div>
                <div class="deco-item"><span>Coffret L / XL</span><div class="dots"></div><span>48€ / 75€</span></div>
            </div>
        </div>
    </section>

    <section class="order-container" id="commander">
        <h2 style="text-align: center; font-family: 'Cormorant Garamond', serif; font-size: 2.5rem; margin-bottom: 40px; color: var(--gold);">Finalisez votre Commande</h2>
        <form id="orderForm">
            <div class="form-group">
                <label>Vos Coordonnées</label>
                <div style="display:grid; grid-template-columns: 1fr 1fr; gap:15px;">
                    <input type="text" name="Client" id="clientName" placeholder="Nom Complet" required>
                    <input type="text" name="Tel" id="clientPhone" placeholder="Téléphone" required>
                </div>
            </div>

            <div class="form-group">
                <label>Produit Souhaité</label>
                <select id="mainProduct" name="Produit" onchange="updateFormDisplay()">
                    <optgroup label="🌹 BOUQUETS">
                        <option value="Bouquet Roses" data-price="25">Bouquet de Roses Personnalisé</option>
                    </optgroup>
                    <optgroup label="🌹 ROSES ÉTERNELLES">
                        <option value="Rose Eternelle Std" data-price="20">Rose Éternelle Standard (20€)</option>
                        <option value="Rose Eternelle Perso" data-price="25">Rose Éternelle Personnalisée (25€)</option>
                    </optgroup>
                    <optgroup label="💎 COLLECTION BIJOUX">
                        <option value="Box Rose+Bague" data-price="20">Box Rose + Bague (20€)</option>
                        <option value="Box Bijoux (Bracelet)" data-price="10">Box Bijoux (Bracelet) (10€)</option>
                    </optgroup>
                </select>
            </div>

            <div id="jewelOptions" class="form-group" style="display:none;">
                <label>Options Bijoux</label>
                <label class="check-card">
                    <input type="checkbox" name="Box_Perso" id="persoBoxJewel" class="extra" value="Perso Box" data-price="5" onchange="calculateTotal()">
                    Personnalisation de la Box (+5€)
                </label>
            </div>

            <div id="eternelleOptions" class="form-group" style="display:none;">
                <label>Configuration Rose Éternelle</label>
                <select name="Couleur_Eternelle" id="eternelleColor">
                    <option value="Rouge">Rouge Classique</option>
                    <option value="Rose">Rose Doux</option>
                    <option value="Bleu">Bleu Royal</option>
                </select>
                <div id="prenomField" style="margin-top: 15px; display:none;">
                    <input type="text" name="Prenom_Eternelle" id="eternellePrenom" placeholder="Prénom pour la personnalisation">
                </div>
            </div>

            <div id="bouquetDetails" class="form-group">
                <label>Nombre de Roses</label>
                <select name="NB_Roses" id="bouquetQty" onchange="calculateTotal()">
                    <option value="13" data-price="25">13 Roses - 25€</option>
                    <option value="18" data-price="35">18 Roses - 35€</option>
                    <option value="30" data-price="59">30 Roses - 59€</option>
                    <option value="50" data-price="99">50 Roses - 99€</option>
                    <option value="101" data-price="225">101 Roses - 225€</option>
                </select>
            </div>

            <div id="personalizationSection" class="form-group">
                <label>Personnalisez votre Bouquet (Options)</label>
                <div class="selection-grid">
                    <div style="grid-column: span 1;">
                        <label class="check-card" id="miniStitchLabel"><input type="checkbox" id="checkMiniStitch" disabled data-value="Mini Stitch"> Mini Stitch <span style="color: var(--out-of-stock); font-size: 0.6rem; margin-left: 5px;">(RUPTURE)</span></label>
                    </div>

                    <div style="grid-column: span 1;">
                        <label class="check-card" id="coeurLabel"><input type="checkbox" id="checkCoeur" disabled data-value="Coeur Inflammable"> Coeur Inflammable <span style="color: var(--out-of-stock); font-size: 0.6rem; margin-left: 5px;">(RUPTURE)</span></label>
                    </div>

                    <label class="check-card"><input type="checkbox" name="Deco" class="extra" id="checkStitchG" value="Stitch Perso" data-price="20" onchange="togglePersoField('checkStitchG', 'fieldStitchG')"> Stitch Personnalisé (+20€)</label>
                    <select id="fieldStitchG" name="Couleur_Stitch_G" class="dynamic-field" onchange="calculateTotal()">
                        <option value="Bleu">Couleur : Bleu</option>
                        <option value="Rose">Couleur : Rose</option>
                    </select>

                    <label class="check-card"><input type="checkbox" name="Deco" class="extra" id="checkGrandDiademe" value="Grand Diadème" data-price="8" onchange="calculateTotal()"> Grand Diadème (+8€)</label>
                    <label class="check-card"><input type="checkbox" name="Deco" class="extra" id="checkPetitDiademe" value="Petit Diadème" data-price="4" onchange="calculateTotal()"> Petit Diadème (+4€)</label>

                    <div style="grid-column: span 1;">
                        <label class="check-card"><input type="checkbox" name="Deco" class="extra" id="checkRuban" value="Ruban Perso" data-price="4" onchange="togglePersoField('checkRuban', 'fieldRuban')"> Ruban Perso (+4€)</label>
                        <input type="text" id="fieldRuban" name="Texte_Ruban" class="dynamic-field" placeholder="Texte du ruban (Prénom...)">
                    </div>

                    <label class="check-card"><input type="checkbox" name="Deco" class="extra" id="checkAiguilles" value="Aiguilles" data-price="6" onchange="calculateTotal()"> Aiguilles Cristal (+6€)</label>
                    <label class="check-card"><input type="checkbox" name="Deco" class="extra" id="checkPapillons" value="Papillons" data-price="2" onchange="calculateTotal()"> Papillons (+2€)</label>
                    <label class="check-card"><input type="checkbox" name="Deco" class="extra" id="checkGypsophile" value="Gypsophile" data-price="5" onchange="calculateTotal()"> Gypsophile (+5€)</label>

                    <div style="grid-column: span 1;">
                        <label class="check-card"><input type="checkbox" name="Deco" class="extra" id="checkLettre" value="Lettre Fleur" data-price="5" onchange="togglePersoField('checkLettre', 'fieldLettre')"> Lettre en fleur (+5€)</label>
                        <input type="text" id="fieldLettre" name="Lettre_Choisie" class="dynamic-field" maxlength="1" placeholder="Tapez 1 seule lettre" style="text-transform: uppercase;">
                    </div>

                    <label class="check-card"><input type="checkbox" name="Deco" class="extra" id="checkBordurePerle" value="Bordure Perle" data-price="4" onchange="calculateTotal()"> Bordure perles (+4€)</label>
                    <label class="check-card"><input type="checkbox" name="Deco" class="extra" id="checkPaillettes" value="Paillettes" data-price="4" onchange="calculateTotal()"> Paillettes (+4€)</label>
                </div>
            </div>

            <div class="form-group">
                <label>Mode de Réception</label>
                <select name="Reception" id="deliveryMethod" onchange="calculateTotal()">
                    <option value="0">Remise en main propre (Lyon) - Gratuit</option>
                    <option value="10" data-label="Envoi Colissimo">Envoi Colissimo (France) - 10€</option>
                    <option value="15" data-label="Envoi International">Envoi International - 15€</option>
                </select>
            </div>

            <div id="livePricing" class="live-details"></div>

            <div class="price-summary">
                <div class="total-amount"><span id="fullPriceDisplay">25</span>€</div>
                <div style="font-size: 0.75rem; margin-top: 10px; color: #aaa;">ACOMPTE CALCULÉ (50%) : <span id="depositDisplay">12.50</span>€</div>
            </div>

            <div class="btn-group">
                <button type="button" class="btn-submit btn-acompte" onclick="prepareOrder(true)">Régler l'Acompte (50%)</button>
                <button type="button" class="btn-submit btn-total" onclick="prepareOrder(false)">Payer le Total (100%)</button>
            </div>
        </form>
    </section>

    <div id="adminPanel">
        <h3>Admin - Gestion des Stocks</h3>
        <div style="margin-bottom: 15px;">
            <label style="display: block; margin-bottom: 5px; font-size: 0.8rem;">Code Admin</label>
            <input type="password" id="adminCode" placeholder="Entrez le code" style="width: 100%; padding: 8px; background: #000; border: 1px solid var(--light-gray); color: #fff;">
            <button onclick="checkAdminCode()" style="margin-top: 10px; padding: 8px 15px; background: var(--gold); color: #000; border: none; cursor: pointer; width: 100%;">Valider</button>
        </div>
        <div id="adminContent" style="display: none;">
            <h4>Stocks Disponibles</h4>

            <!-- Bouquets -->
            <div style="margin-bottom: 10px;">
                <label style="display: block; margin-bottom: 5px; font-size: 0.75rem;">Mini Stitch</label>
                <select id="stockMiniStitch" style="width: 100%; padding: 5px;">
                    <option value="true">Disponible</option>
                    <option value="false">Rupture</option>
                </select>
            </div>

            <div style="margin-bottom: 10px;">
                <label style="display: block; margin-bottom: 5px; font-size: 0.75rem;">Cœur Inflammable</label>
                <select id="stockCoeur" style="width: 100%; padding: 5px;">
                    <option value="true">Disponible</option>
                    <option value="false">Rupture</option>
                </select>
            </div>

            <div style="margin-bottom: 10px;">
                <label style="display: block; margin-bottom: 5px; font-size: 0.75rem;">Stitch Personnalisé</label>
                <select id="stockStitchPerso" style="width: 100%; padding: 5px;">
                    <option value="true">Disponible</option>
                    <option value="false">Rupture</option>
                </select>
            </div>

            <div style="margin-bottom: 10px;">
                <label style="display: block; margin-bottom: 5px; font-size: 0.75rem;">Grand Diadème</label>
                <select id="stockGrandDiademe" style="width: 100%; padding: 5px;">
                    <option value="true">Disponible</option>
                    <option value="false">Rupture</option>
                </select>
            </div>

            <div style="margin-bottom: 10px;">
                <label style="display: block; margin-bottom: 5px; font-size: 0.75rem;">Petit Diadème</label>
                <select id="stockPetitDiademe" style="width: 100%; padding: 5px;">
                    <option value="true">Disponible</option>
                    <option value="false">Rupture</option>
                </select>
            </div>

            <div style="margin-bottom: 10px;">
                <label style="display: block; margin-bottom: 5px; font-size: 0.75rem;">Ruban Perso</label>
                <select id="stockRuban" style="width: 100%; padding: 5px;">
                    <option value="true">Disponible</option>
                    <option value="false">Rupture</option>
                </select>
            </div>

            <div style="margin-bottom: 10px;">
                <label style="display: block; margin-bottom: 5px; font-size: 0.75rem;">Aiguilles Cristal</label>
                <select id="stockAiguilles" style="width: 100%; padding: 5px;">
                    <option value="true">Disponible</option>
                    <option value="false">Rupture</option>
                </select>
            </div>

            <div style="margin-bottom: 10px;">
                <label style="display: block; margin-bottom: 5px; font-size: 0.75rem;">Papillons</label>
                <select id="stockPapillons" style="width: 100%; padding: 5px;">
                    <option value="true">Disponible</option>
                    <option value="false">Rupture</option>
                </select>
            </div>

            <div style="margin-bottom: 10px;">
                <label style="display: block; margin-bottom: 5px; font-size: 0.75rem;">Gypsophile</label>
                <select id="stockGypsophile" style="width: 100%; padding: 5px;">
                    <option value="true">Disponible</option>
                    <option value="false">Rupture</option>
                </select>
            </div>

            <div style="margin-bottom: 10px;">
                <label style="display: block; margin-bottom: 5px; font-size: 0.75rem;">Lettre en fleur</label>
                <select id="stockLettreFleur" style="width: 100%; padding: 5px;">
                    <option value="true">Disponible</option>
                    <option value="false">Rupture</option>
                </select>
            </div>

            <div style="margin-bottom: 10px;">
                <label style="display: block; margin-bottom: 5px; font-size: 0.75rem;">Bordure perles</label>
                <select id="stockBordurePerle" style="width: 100%; padding: 5px;">
                    <option value="true">Disponible</option>
                    <option value="false">Rupture</option>
                </select>
            </div>

            <div style="margin-bottom: 10px;">
                <label style="display: block; margin-bottom: 5px; font-size: 0.75rem;">Paillettes</label>
                <select id="stockPaillettes" style="width: 100%; padding: 5px;">
                    <option value="true">Disponible</option>
                    <option value="false">Rupture</option>
                </select>
            </div>

            <!-- Univers Prière -->
            <div style="margin-bottom: 10px;">
                <label style="display: block; margin-bottom: 5px; font-size: 0.75rem;">Univers Prière</label>
                <select id="stockPriere" style="width: 100%; padding: 5px;">
                    <option value="true">Disponible</option>
                    <option value="false">Rupture</option>
                </select>
            </div>

            <button onclick="saveStocks()" style="padding: 8px 15px; background: var(--rose-petal); color: #fff; border: none; cursor: pointer; width: 100%;">Enregistrer</button>
        </div>
    </div>

    <button id="adminButton" onclick="toggleAdminPanel()">ADMIN</button>

    <footer>
        BY.LINOUSH CRÉATION © 2026 | LYON <br>
        SITE RÉALISÉ PAR <a href="https://www.instagram.com/nexusweb69" target="_blank" class="footer-link">NEXUSWEB</a>
    </footer>

    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
    <script>
        AOS.init({ duration: 1000, once: true });

        // Code admin (à personnaliser)
        const ADMIN_CODE = "LINOUSH2026";

        function toggleAdminPanel() {
            const panel = document.getElementById('adminPanel');
            panel.style.display = panel.style.display === 'block' ? 'none' : 'block';
            document.getElementById('adminCode').value = "";
            document.getElementById('adminContent').style.display = "none";
        }

        function checkAdminCode() {
            const code = document.getElementById('adminCode').value;
            if(code === ADMIN_CODE) {
                document.getElementById('adminContent').style.display = "block";
                loadStocks();
            } else {
                alert("Code incorrect !");
            }
        }

        function loadStocks() {
            // Charger les valeurs actuelles des stocks
            document.getElementById('stockMiniStitch').value = document.getElementById('checkMiniStitch').disabled ? "false" : "true";
            document.getElementById('stockCoeur').value = document.getElementById('checkCoeur').disabled ? "false" : "true";
            document.getElementById('stockStitchPerso').value = document.getElementById('checkStitchG').disabled ? "false" : "true";
            document.getElementById('stockGrandDiademe').value = document.getElementById('checkGrandDiademe').disabled ? "false" : "true";
            document.getElementById('stockPetitDiademe').value = document.getElementById('checkPetitDiademe').disabled ? "false" : "true";
            document.getElementById('stockRuban').value = document.getElementById('checkRuban').disabled ? "false" : "true";
            document.getElementById('stockAiguilles').value = document.getElementById('checkAiguilles').disabled ? "false" : "true";
            document.getElementById('stockPapillons').value = document.getElementById('checkPapillons').disabled ? "false" : "true";
            document.getElementById('stockGypsophile').value = document.getElementById('checkGypsophile').disabled ? "false" : "true";
            document.getElementById('stockLettreFleur').value = document.getElementById('checkLettre').disabled ? "false" : "true";
            document.getElementById('stockBordurePerle').value = document.getElementById('checkBordurePerle').disabled ? "false" : "true";
            document.getElementById('stockPaillettes').value = document.getElementById('checkPaillettes').disabled ? "false" : "true";
            document.getElementById('stockPriere').value = document.querySelector('.deco-cat.sold-out') ? "false" : "true";
        }

        function saveStocks() {
            // Stocks existants
            const miniStitch = document.getElementById('stockMiniStitch').value;
            const coeur = document.getElementById('stockCoeur').value;
            const priere = document.getElementById('stockPriere').value;

            // Options de personnalisation
            const stitchPerso = document.getElementById('stockStitchPerso').value;
            const grandDiademe = document.getElementById('stockGrandDiademe').value;
            const petitDiademe = document.getElementById('stockPetitDiademe').value;
            const ruban = document.getElementById('stockRuban').value;
            const aiguilles = document.getElementById('stockAiguilles').value;
            const papillons = document.getElementById('stockPapillons').value;
            const gypsophile = document.getElementById('stockGypsophile').value;
            const lettreFleur = document.getElementById('stockLettreFleur').value;
            const bordurePerle = document.getElementById('stockBordurePerle').value;
            const paillettes = document.getElementById('stockPaillettes').value;

            // Appliquer les changements aux éléments du DOM
            document.getElementById('miniStitchLabel').style.opacity = miniStitch === "true" ? "1" : "0.5";
            document.getElementById('checkMiniStitch').disabled = miniStitch === "false";

            document.getElementById('coeurLabel').style.opacity = coeur === "true" ? "1" : "0.5";
            document.getElementById('checkCoeur').disabled = coeur === "false";

            const stitchPersoLabel = document.querySelector('label[for="checkStitchG"]');
            stitchPersoLabel.style.opacity = stitchPerso === "true" ? "1" : "0.5";
            document.getElementById('checkStitchG').disabled = stitchPerso === "false";

            const grandDiademeLabel = document.querySelector('label[for="checkGrandDiademe"]');
            grandDiademeLabel.style.opacity = grandDiademe === "true" ? "1" : "0.5";
            document.getElementById('checkGrandDiademe').disabled = grandDiademe === "false";

            const petitDiademeLabel = document.querySelector('label[for="checkPetitDiademe"]');
            petitDiademeLabel.style.opacity = petitDiademe === "true" ? "1" : "0.5";
            document.getElementById('checkPetitDiademe').disabled = petitDiademe === "false";

            const rubanLabel = document.querySelector('label[for="checkRuban"]');
            rubanLabel.style.opacity = ruban === "true" ? "1" : "0.5";
            document.getElementById('checkRuban').disabled = ruban === "false";

            const aiguillesLabel = document.querySelector('label[for="checkAiguilles"]');
            aiguillesLabel.style.opacity = aiguilles === "true" ? "1" : "0.5";
            document.getElementById('checkAiguilles').disabled = aiguilles === "false";

            const papillonsLabel = document.querySelector('label[for="checkPapillons"]');
            papillonsLabel.style.opacity = papillons === "true" ? "1" : "0.5";
            document.getElementById('checkPapillons').disabled = papillons === "false";

            const gypsophileLabel = document.querySelector('label[for="checkGypsophile"]');
            gypsophileLabel.style.opacity = gypsophile === "true" ? "1" : "0.5";
            document.getElementById('checkGypsophile').disabled = gypsophile === "false";

            const lettreFleurLabel = document.querySelector('label[for="checkLettre"]');
            lettreFleurLabel.style.opacity = lettreFleur === "true" ? "1" : "0.5";
            document.getElementById('checkLettre').disabled = lettreFleur === "false";

            const bordurePerleLabel = document.querySelector('label[for="checkBordurePerle"]');
            bordurePerleLabel.style.opacity = bordurePerle === "true" ? "1" : "0.5";
            document.getElementById('checkBordurePerle').disabled = bordurePerle === "false";

            const paillettesLabel = document.querySelector('label[for="checkPaillettes"]');
            paillettesLabel.style.opacity = paillettes === "true" ? "1" : "0.5";
            document.getElementById('checkPaillettes').disabled = paillettes === "false";

            const priereCat = document.querySelector('.deco-cat.sold-out');
            if(priereCat) {
                if(priere === "true") {
                    priereCat.classList.remove('sold-out');
                    priereCat.querySelector('.sold-out-badge').style.display = "none";
                } else {
                    priereCat.classList.add('sold-out');
                    priereCat.querySelector('.sold-out-badge').style.display = "inline";
                }
            }

            alert("Stocks mis à jour !");
            toggleAdminPanel();
        }

        function togglePersoField(checkId, fieldId) {
            const checkbox = document.getElementById(checkId);
            const field = document.getElementById(fieldId);
            field.style.display = checkbox.checked ? "block" : "none";
            if(!checkbox.checked) field.value = "";
            calculateTotal();
        }

        function updateFormDisplay() {
            const product = document.getElementById('mainProduct').value;
            document.getElementById('bouquetDetails').style.display = (product === 'Bouquet Roses') ? 'block' : 'none';
            document.getElementById('personalizationSection').style.display = (product === 'Bouquet Roses') ? 'block' : 'none';
            document.getElementById('eternelleOptions').style.display = product.startsWith('Rose Eternelle') ? 'block' : 'none';
            document.getElementById('prenomField').style.display = (product === 'Rose Eternelle Perso') ? 'block' : 'none';
            document.getElementById('jewelOptions').style.display = (product.startsWith('Box')) ? 'block' : 'none';
            calculateTotal();
        }

        function calculateTotal() {
            const productSelect = document.getElementById('mainProduct');
            const livePricing = document.getElementById('livePricing');
            livePricing.innerHTML = "";

            let total = 0;
            let productPrice = 0;
            let productName = "";

            if(productSelect.value === 'Bouquet Roses') {
                const opt = document.getElementById('bouquetQty').options[document.getElementById('bouquetQty').selectedIndex];
                productPrice = parseInt(opt.getAttribute('data-price'));
                productName = `Bouquet (${opt.value} roses)`;
            } else {
                productPrice = parseInt(productSelect.options[productSelect.selectedIndex].getAttribute('data-price'));
                productName = productSelect.options[productSelect.selectedIndex].text.split('(')[0];
            }
            total += productPrice;
            livePricing.innerHTML += `<div><span>${productName}</span><span>${productPrice}€</span></div>`;

            document.querySelectorAll('.extra:checked').forEach(item => {
                let p = parseInt(item.getAttribute('data-price'));
                total += p;
                let label = item.value;
                if(item.id === 'checkStitchG') label += ` (${document.getElementById('fieldStitchG').value})`;
                livePricing.innerHTML += `<div><span>+ ${label}</span><span>${p}€</span></div>`;
            });

            const delivery = document.getElementById('deliveryMethod');
            const delPrice = parseInt(delivery.value);
            if(delPrice > 0) {
                total += delPrice;
                const delLabel = delivery.options[delivery.selectedIndex].getAttribute('data-label') || "Livraison";
                livePricing.innerHTML += `<div><span>+ ${delLabel}</span><span>${delPrice}€</span></div>`;
            }

            document.getElementById('fullPriceDisplay').innerText = total;
            document.getElementById('depositDisplay').innerText = (total / 2).toFixed(2);
            return total;
        }

        let currentPayPalURL = "";

        async function prepareOrder(isDeposit) {
            const name = document.getElementById('clientName').value;
            const phone = document.getElementById('clientPhone').value;
            if(!name || !phone) { alert("Nom et téléphone requis."); return; }

            const total = calculateTotal();
            const amount = isDeposit ? (total / 2) : total;
            const type = isDeposit ? "ACOMPTE 50%" : "PAYÉ 100%";

            const product = document.getElementById('mainProduct').value;
            let qty = (product === 'Bouquet Roses') ? document.getElementById('bouquetQty').value + " roses" : "";
            let extras = [];
            document.querySelectorAll('.extra:checked').forEach(e => {
                let val = e.value;
                if(e.id === 'checkStitchG') val += ` (${document.getElementById('fieldStitchG').value})`;
                extras.push(val);
            });

            let recap = `📌 ${type}\n👤 Client: ${name}\n📞 Tél: ${phone}\n🎁 Produit: ${product} ${qty}`;
            if(extras.length > 0) recap += `\n✨ Décos: ${extras.join(', ')}`;
            if(document.getElementById('checkRuban').checked) recap += `\n🎗️ Ruban: ${document.getElementById('fieldRuban').value}`;
            if(document.getElementById('checkLettre').checked) recap += `\n🔡 Lettre: ${document.getElementById('fieldLettre').value.toUpperCase()}`;
            if(product === 'Rose Eternelle Perso') recap += `\n✍️ Prénom Rose: ${document.getElementById('eternellePrenom').value}`;
            recap += `\n💰 Montant: ${amount.toFixed(2)}€`;

            const formData = new FormData(document.getElementById('orderForm'));
            formData.append("Recapitulatif_Complet", recap);

            fetch("https://formspree.io/f/mlgwjnbq", {
                method: "POST",
                body: formData,
                headers: { 'Accept': 'application/json' }
            });

            document.getElementById('orderSummaryText').innerText = recap;
            currentPayPalURL = `https://www.paypal.com/paypalme/cherifilina/${amount.toFixed(2)}`;
            navigator.clipboard.writeText(recap);
            document.getElementById('thankYouModal').style.display = 'flex';
        }

        function redirectToPayPal() { window.location.href = currentPayPalURL; }

        const bg = document.getElementById('rosesBg');
        for (let i = 0; i < 20; i++) {
            const p = document.createElement('div');
            p.className = 'petal';
            p.style.width = p.style.height = Math.random() * 15 + 10 + 'px';
            p.style.left = Math.random() * 100 + '%';
            p.style.animationDuration = Math.random() * 7 + 8 + 's';
            bg.appendChild(p);
        }
        updateFormDisplay();
    </script>
</body>
</html>