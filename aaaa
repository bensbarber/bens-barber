def parse_duration(s):
“”“Convertit ‘10m’, ‘2h’, ‘1d’ en timedelta.”””
units = {“s”: 1, “m”: 60, “h”: 3600, “d”: 86400}
match = re.fullmatch(r”(\d+)([smhd])”, s.lower())
if not match:
return None
return timedelta(seconds=int(match[1]) * units[match[2]])

