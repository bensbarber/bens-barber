async def send_log(guild, log_type, embed):
config = get_guild(“logs.json”, guild.id)
channel_id = config.get(log_type)
if not channel_id:
return
channel = guild.get_channel(int(channel_id))
if channel:
await channel.send(embed=embed)

async def add_sanction(guild_id, member_id, sanction_type, reason, mod_id):
sanctions = get_member(“sanctions.json”, guild_id, member_id)
sanctions.setdefault(“list”, []).append({
“type”: sanction_type, “reason”: reason,
“mod”: str(mod_id), “date”: datetime.utcnow().isoformat()
})
set_member(“sanctions.json”, guild_id, member_id, sanctions)

async def log_mod_action(guild, action, member, mod, reason=“Aucune”):
colors = {“warn”: 0xffd700, “mute”: 0xff8c00, “kick”: 0xff4500,
“ban”: 0xff0000, “unban”: 0x00ff00, “unmute”: 0x00bfff}
embed = discord.Embed(title=f”🔨 {action.upper()}”, color=colors.get(action, 0x888888), timestamp=datetime.utcnow())
embed.add_field(name=“Membre”,     value=f”{member} (`{member.id}`)”, inline=True)
embed.add_field(name=“Modérateur”, value=str(mod),                    inline=True)
embed.add_field(name=“Raison”,     value=reason,                      inline=False)
await send_log(guild, “modlog”, embed)

async def get_or_create_mute_role(guild):
config = get_guild(“modconfig.json”, guild.id)
rid    = config.get(“muterole”)
role   = guild.get_role(int(rid)) if rid else None
if not role:
role = discord.utils.get(guild.roles, name=“Muted”)
if not role:
role = await guild.create_role(name=“Muted”)
for channel in guild.channels:
try:
await channel.set_permissions(role, send_messages=False, speak=False, add_reactions=False)
except:
pass
return role

async def punish_antiraid(guild, member, punish_type, reason):
try:
if punish_type == “kick”:
await member.kick(reason=reason)
elif punish_type == “ban”:
await member.ban(reason=reason)
elif punish_type == “mute”:
role = await get_or_create_mute_role(guild)
await member.add_roles(role, reason=reason)
await add_sanction(guild.id, member.id, punish_type, reason, “AutoMod”)
except:
pass

