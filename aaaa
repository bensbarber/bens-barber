DATA_DIR = “data”
os.makedirs(DATA_DIR, exist_ok=True)

def _path(filename):
return os.path.join(DATA_DIR, filename)

def db_load(filename):
path = _path(filename)
if os.path.exists(path):
with open(path, “r”, encoding=“utf-8”) as f:
return json.load(f)
return {}

def db_save(filename, data):
with open(_path(filename), “w”, encoding=“utf-8”) as f:
json.dump(data, f, indent=2, ensure_ascii=False)

def get_guild(filename, guild_id):
return db_load(filename).get(str(guild_id), {})

def set_guild(filename, guild_id, guild_data):
data = db_load(filename)
data[str(guild_id)] = guild_data
db_save(filename, data)

def get_member(filename, guild_id, member_id):
return db_load(filename).get(str(guild_id), {}).get(str(member_id), {})

def set_member(filename, guild_id, member_id, member_data):
data = db_load(filename)
data.setdefault(str(guild_id), {})[str(member_id)] = member_data
db_save(filename, data)

